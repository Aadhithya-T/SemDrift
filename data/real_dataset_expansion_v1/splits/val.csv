"semdrift_exp_drift_000609","networkx","6da4704cbf32ba6f50f6d9c46cc0a071e3a87985","networkx/readwrite/pajek.py","make_qstr","def make_qstr(t):
    """"""Returns the string representation of t.

    Wrap the string in double-quotes if it contains whitespace, a double
    quote, or a backslash, escaping the latter two so the Pajek reader
    (which splits with shlex) recovers the original string unchanged.
    """"""
    if not isinstance(t, str):
        t = str(t)
    if any(c.isspace() or c in '""\\\\' for c in t):
        t = t.replace(""\\\\"", ""\\\\\\\\"").replace('""', '\\\\""')
        t = f'""{t}""'
    return t","Wrap the string in double-quotes if it contains whitespace, a double
