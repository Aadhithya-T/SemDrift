"semdrift_drift_001281","paramiko","master_head","paramiko/paramiko/util.py","deflate_long","def deflate_long(n, add_sign_padding=True):
    """"""turns a long-int into a normalized byte string
    (adapted from Crypto.Util.number)""""""
    # after much testing, this algorithm was deemed to be the fastest
    s = bytes()
    n = int(n)
    while (n != 0) and (n != -1):
        s = struct.pack("">I"", n & xffffffff) + s
        n >>= 32
    # strip off leading zeros, FFs
    for i in enumerate(s):
        if (n == 0) and (i[1] != 0):
            break
        if (n == -1) and (i[1] != 0xFF):
            break
    else:
        # degenerate case, n was either 0 or -1
        i = (0,)
        if n == 0:
            s = zero_byte
        else:
            s = max_byte
    s = s[i[0] :]
    if add_sign_padding:
        if (n == 0) and (byte_ord(s[0]) >= 0x80):
            s = zero_byte + s
        if (n == -1) and (byte_ord(s[0]) < 0x80):
            s = max_byte + s
    return s","turns a long-int into a normalized byte string
(adapted from Crypto.Util.number)

:param max_retries: Controls fallback execution behavior.","1","parameter_obsolete","Docstring documents parameter 'max_retries' which does not exist in the code signature.","val"
"semdrift_exp_drift_000404","networkx","6da4704cbf32ba6f50f6d9c46cc0a071e3a87985","networkx/classes/digraph.py","add_edges_from","def add_edges_from(self, ebunch_to_add, **attr):
