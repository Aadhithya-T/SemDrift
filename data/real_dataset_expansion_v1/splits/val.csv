"semdrift_clean_002337","paramiko","142f593","paramiko/paramiko/transport.py","send_ignore","def send_ignore(self, byte_count=None):
        """"""
        Send a junk packet across the encrypted link.  This is sometimes used
        to add ""noise"" to a connection to confuse would-be attackers.  It can
        also be used as a keep-alive for long lived connections traversing
        firewalls.

        :param int byte_count:
            the number of random bytes to send in the payload of the ignored
            packet -- defaults to a random number from 10 to 41.
        """"""
        m = Message()
        m.add_byte(cMSG_IGNORE)
        if byte_count is None:
            byte_count = (byte_ord(os.urandom(1)) % 32) + 10
        m.add_bytes(os.urandom(byte_count))
        self._send_user_message(m)","Send a junk packet across the encrypted link.  This is sometimes used
