"semdrift_exp_drift_001928","networkx","6da4704cbf32ba6f50f6d9c46cc0a071e3a87985","networkx/algorithms/isomorphism/vf2pp.py","vf2pp_subgraph_isomorphism","def vf2pp_subgraph_isomorphism(FG, SG, node_label=None, default_label=None):
    """"""Return an isomorphic mapping between nodes of `FG` and `SG` if it exists.

    Parameters
    ----------
    FG, SG : NetworkX Graph or MultiGraph instances.
        The two graphs to check for isomorphism.

    node_label : str, optional
