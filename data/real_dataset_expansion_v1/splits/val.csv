        m.add_int(self.remote_chanid)
        m.add_string(""exec"")
        m.add_boolean(True)
        m.add_string(command)
        self._event_pending()
        self.transport._send_user_message(m)
        self._wait_for_event()","Execute a comm_opt on the server.  If the server allows it, the channel
