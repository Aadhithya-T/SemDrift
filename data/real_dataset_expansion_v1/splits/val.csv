"semdrift_exp_drift_001057","networkx","6da4704cbf32ba6f50f6d9c46cc0a071e3a87985","networkx/algorithms/shortest_paths/weighted.py","relax","def relax(to_scan):
        """"""Relax out-edges of relabeled nodes.""""""
        relabeled = set()
        # Scan nodes in to_scan in topological order and relax incident
        # out-edges. Add the relabeled nodes to labeled.
        for u in to_scan:
            d_u = d[u]
            for v, e in G_succ[u].items():
                w_e = weight(u, v, e)
                if d_u + w_e < d[v]:
                    d[v] = d_u + w_e
                    pred[v] = u
