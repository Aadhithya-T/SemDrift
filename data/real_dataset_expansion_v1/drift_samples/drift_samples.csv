>>> lp2bs_zpk(z, p, k, wo, bw)
(   array([0.+0.5j, 0.+0.5j, 0.-0.5j, 0.-0.5j]),
    array([14.2681928 +0.j, -0.02506281+0.j,  0.01752149+0.j, -9.97493719+0.j]),
    -12.857142857142858)

