"semdrift_exp_drift_000979","sqlalchemy","900646931b7fd03845ebe4fc8be84f77a8580123","lib/sqlalchemy/sql/compiler.py","_label_select_column","def _label_select_column(
        self,
        select,
        column,
        populate_result_map,
        asfrom,
        column_clause_args,
        name=None,
        proxy_name=None,
        fallback_label_name=None,
        within_columns_clause=True,
        column_is_repeated=False,
        need_column_expressions=False,
