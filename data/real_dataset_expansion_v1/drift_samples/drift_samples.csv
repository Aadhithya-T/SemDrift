"semdrift_exp_drift_001309","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/functions/special/tensor_functions.py","is_above_fermi","def is_above_fermi(self):
        """"""
        True if Delta can be non-zero above fermi.

        Examples
        ========

        >>> from sympy import KroneckerDelta, Symbol
        >>> a = Symbol('a', above_fermi=True)
        >>> i = Symbol('i', below_fermi=True)
        >>> p = Symbol('p')
