        def f(z): return np.exp(z**2)  # example function
        N = 10  # number of terms in the Taylor expansion
        zz = np.exp(2j * np.pi * np.arange(N) / N)  # roots of unity
        c = np.fft.fft(f(zz)) / N
        c = np.real(c)  # c must be real by symmetry


