"semdrift_exp_drift_001913","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/densebasic.py","dup_from_list","def dup_from_list(f: list[int] | list[Er], K: Domain[Er]) -> dup[Er]:
