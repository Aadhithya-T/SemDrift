    if check_input:
        X = check_array(
            X,
            accept_sparse=""csc"",
            dtype=[np.float64, np.float32],
            order=""F"",
            copy=copy_X,
        )
        y = check_array(
            y,
            accept_sparse=""csc"",
            dtype=X.dtype.type,
            order=""F"",
            copy=False,
            ensure_2d=False,
        )
        if Xy is not None:
            # Xy should be a 1d contiguous array or a 2D C ordered array
            Xy = check_array(
                Xy, dtype=X.dtype.type, order=""C"", copy=False, ensure_2d=False
            )

    n_samples, n_features = X.shape

    multi_output = False
    if y.ndim != 1:
        multi_output = True
        n_targets = y.shape[1]

    if multi_output and positive:
