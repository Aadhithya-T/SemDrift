"semdrift_exp_drift_001222","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/stats/rv.py","where","def where(condition, given_condition=None, **kwargs):
    """"""
    Returns the domain where a condition is True.

    Examples
    ========

    >>> from sympy.stats import where, Die, Normal
    >>> from sympy import And

    >>> D1, D2 = Die('a', 6), Die('b', 6)
    >>> a, b = D1.symbol, D2.symbol
