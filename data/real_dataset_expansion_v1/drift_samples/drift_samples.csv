"semdrift_drift_002600","scikit-learn","master_head","sklearn/utils/estimator_checks.py","check_classifiers_multilabel_output_format_decision_function","def check_classifiers_multilabel_output_format_decision_function(name, classifier_orig):
    """"""Check the output of the `decision_function` method for classifiers supporting
    multilabel-indicator targets.""""""
    classifier = clone(classifier_orig)
