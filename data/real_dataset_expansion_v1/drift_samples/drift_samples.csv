"semdrift_exp_drift_001846","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/stats/_multivariate.py","_var","def _var(self, dim, df, scale):
        """"""Variance of the inverse Wishart distribution.

        Parameters
        ----------
        dim : int
            Dimension of the scale matrix
        %(_doc_default_callparams)s

        Notes
        -----
        As this function does no argument checking, it should not be
        called directly; use 'var' instead.

        """"""
        if df > dim + 3:
            var = (df - dim + 1) * scale**2
            diag = scale.diagonal()  # 1 x dim array
            var += (df - dim - 1) * np.outer(diag, diag)
            var /= (df - dim) * (df - dim - 1)**2 * (df - dim - 3)
        else:
            var = None
        return var","Variance of the inverse Wishart distribution.

Parameters
----------
dim : int
    Dimension of the scale matrix
%(_doc_default_callparams)s

Notes
-----
As this function does no argument checking, it should not be
