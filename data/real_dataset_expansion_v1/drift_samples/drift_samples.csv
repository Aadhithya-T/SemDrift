"semdrift_drift_001724","scikit-learn","master_head","scikit-learn/sklearn/discriminant_analysis.py","predict_log_proba","def predict_log_proba(self, X):
        """"""Estimate log probability.

        Parameters
        ----------
        X : array-like of shape (n_samples, n_features)
            Input data.

        Returns
        -------
        C : ndarray of shape (n_samples, n_classes)
            Estimated log probabilities.
        """"""
        check_same_namespace(X, self, attribute=""coef_"", method=""predict_log_proba"")
        xp, _ = get_namespace(X)
        prediction = self.predict_proba(X)

