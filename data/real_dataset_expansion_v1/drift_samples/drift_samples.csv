                if name[0] is not None:
                    label_aggregate = (
                        label_aggregate[:-1] + f"" +/- {legend_metric['std']:0.2f})""
                    )
                else:
                    label_aggregate = (
                        label_aggregate + f"" +/- {legend_metric['std']:0.2f}""
                    )
