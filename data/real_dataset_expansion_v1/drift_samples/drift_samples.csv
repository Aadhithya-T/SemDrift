                                     kx, tx, x_fit, ky,
                                     ty, y_fit, Z_fit, s,
                                     fp0, maxit=maxit, p_init=p)
    return return_NdBSpline(fp_sm, (tx, ty, C_sm), (kx, ky))","Core adaptive bivariate spline fitter using the 1/p-penalty convention.

Parameters
----------
x, y : array_like
