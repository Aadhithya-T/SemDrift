"semdrift_exp_drift_001584","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/fft/_realtransforms.py","dctn","def dctn(x, type=2, s=None, axes=None, norm=None, overwrite_x=False,
         workers=None, *, orthogonalize=None):
    """"""
