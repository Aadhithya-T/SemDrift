        Shape of the array.
    """"""
    shape = x.shape
    if axis is not None:
        s = shape[axis]
        # Dask arrays uses non-standard NaN instead of None
        if s is None or math.isnan(s):
            msg = f""Unsupported lazy shape for axis {axis}""
            raise TypeError(msg)
