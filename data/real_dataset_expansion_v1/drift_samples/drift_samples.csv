"semdrift_exp_drift_001908","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/integrate/_ode.py","_transform_banded_jac","def _transform_banded_jac(bjac):
    """"""
    Convert a real matrix of the form (for example)

        [0 0 A B]        [0 0 0 B]
        [0 0 C D]        [0 0 A D]
        [E F G H]   to   [0 F C H]
        [I J K L]        [E J G L]
                         [I 0 K 0]

    That is, every other column is shifted up one.
    """"""
    # Shift every other column.
    newjac = zeros((bjac.shape[0] + 1, bjac.shape[1]))
    newjac[1:, ::2] = bjac[:, ::2]
    newjac[:-1, 1::2] = bjac[:, 1::2]
    return newjac","Convert a real matrix of the form (for example)

