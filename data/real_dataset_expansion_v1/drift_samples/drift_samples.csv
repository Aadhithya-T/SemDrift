                            )
                        except Exception as error:
                            raise MarkupError(
                                f""error parsing {open_tag.parameters!r}; {error}""
                            ) from None

                        if handler_name:
                            meta_params = (
                                handler_name,
                                meta_params
                                if isinstance(meta_params, tuple)
                                else (meta_params,),
                            )

                    else:
