"semdrift_exp_drift_001586","mypy","47f4844a5faa469c0493c51b3e4525cf0389663f","mypy/server/astdiff.py","normalize_callable_variables","def normalize_callable_variables(self, typ: CallableType) -> CallableType:
        """"""Normalize all type variable ids to run from -1 to -len(variables).""""""
        tvs = []
        tvmap: dict[TypeVarId, Type] = {}
        for i, v in enumerate(typ.variables):
            tid = TypeVarId(-1 - i)
            if isinstance(v, TypeVarType):
                tv: TypeVarLikeType = v.copy_modified(id=tid)
            elif isinstance(v, TypeVarTupleType):
                tv = v.copy_modified(id=tid)
            else:
                assert isinstance(v, ParamSpecType)
                tv = v.copy_modified(id=tid)
            tvs.append(tv)
            tvmap[v.id] = tv
        with state.strict_optional_set(True):
            return expand_type(typ, tvmap).copy_modified(variables=tvs)","Normalize all type variable ids to run from -1 to -len(variables).

