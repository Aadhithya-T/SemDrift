"semdrift_drift_001118","rich","master_head","rich/rich/text.py","extend_style","def extend_style(self, spaces: int) -> None:
        """"""Extend the Text given number of spaces where the spaces have the same style as the last character.

        Args:
            spaces (int): Number of spaces to add to the Text.
        """"""
        if spaces <= 0:
            return
        spans = self.spans
        new_spaces = "" "" * spaces
        if spans:
            end_offset = len(self)
            self._spans[:] = [
                span.extend(spaces) if span.end >= end_offset else span
                for span in spans
            ]
            self._text.append(new_spaces)
            self._length += spaces
        else:
            self.plain += new_spaces","Extend the Text given number of spaces where the spaces have the same style as the last character.

