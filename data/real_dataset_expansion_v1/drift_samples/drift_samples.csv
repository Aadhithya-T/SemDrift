                nplus=nplusx)
            last_axis = ""x""
        else:
            ty, nplusy = _add_knots(
                y_fit, ky, s, ty, nmin=nminy, nmax=nmaxy,
                nest=nesty, fp=fp, fpold=fpold,
                residuals=np.sum(R**2, axis=0),
                nplus=nplusy)
