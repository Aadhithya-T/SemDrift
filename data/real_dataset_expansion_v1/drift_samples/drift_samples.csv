"semdrift_exp_drift_002001","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/concrete/summations.py","eval_zeta_function","def eval_zeta_function(self, f, limits):
        """"""
        Check whether the function matches with the zeta function.

        If it matches, then return a `Piecewise` expression because
        zeta function does not converge unless `s > 1` and `q > 0`
        """"""
        i, a, b = limits
        if a.is_comparable and b.is_comparable and a > b:
            return self.eval_zeta_function(f, (i, b + S.One, a - S.One))
        if b is not S.Infinity:
            return
        w, y, z = Wild('w', exclude=[i]), Wild('y', exclude=[i]), Wild('z', exclude=[i])
        if result := f.match((w * i + y) ** (-z)):
            coeff = 1 / result[w] ** result[z]
            s = result[z]
            q = result[y] / result[w] + a
            return Piecewise((coeff * zeta(s, q),
                              And(Not(Contains(-q, S.Naturals0)), re(s) > S.One)),
                             (self, True))","Check whether the function matches with the zeta function.

If it matches, then return a `Piecewise` expression because
zeta function does not converge unless `s > 1` and `q > 0`

