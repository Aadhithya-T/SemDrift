"semdrift_drift_002005","scikit-learn","master_head","ensemble/_hist_gradient_boosting/gradient_boosting.py","_encode_y","def _encode_y(self, y):
        """"""Create self._label_encoder and encode y correspondingly.""""""
        # encode classes into 0 ... n_classes - 1 and sets attributes classes_
        # and n_trees_per_iteration_
        check_classification_targets(y)

        # We need to store the label encoder in case y_val needs to be label encoded,
        # too.
        self._label_encoder = LabelEncoder()
        encoded_y = self._label_encoder.fit_transform(y)
        self.classes_ = self._label_encoder.classes_
        n_classes = self.classes_.shape[0]
        # only 1 tree for binary classification. For multiclass classification,
        # we build 1 tree per class.
        self.n_trees_per_iteration_ = 1 if n_classes <= 2 else n_classes
        encoded_y = encoded_y.astype(Y_DTYPE, copy=False)
        return encoded_y","Create self._label_encoder and encode y correspondingly.

