    >>> print(f""Original Score: {score:.3f}"")
    Original Score: 0.810
    >>> print(
    ...     f""Permutation Scores: {permutation_scores.mean():.3f} +/- ""
    ...     f""{permutation_scores.std():.3f}""
    ... )
    Permutation Scores: 0.505 +/- 0.057
    >>> print(f""P-value: {pvalue:.3f}"")
    P-value: 0.010
