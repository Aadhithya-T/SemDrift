"semdrift_exp_drift_001178","mypy","47f4844a5faa469c0493c51b3e4525cf0389663f","mypy/stats.py","record_call_target_precision","def record_call_target_precision(self, o: CallExpr) -> None:
        """"""Record precision of formal argument types used in a call.""""""
        if not self.typemap or o.callee not in self.typemap:
