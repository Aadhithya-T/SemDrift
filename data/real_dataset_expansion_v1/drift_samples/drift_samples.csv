"semdrift_drift_000635","scikit-learn","master_head","sklearn/ensemble/_gb.py","predict","def predict(self, X):
        """"""Predict class for X.

        Parameters
        ----------
        X : {array-like, sparse matrix} of shape (n_samples, n_features)
            The input samples. Internally, it will be converted to
            ``dtype=np.float32`` and if a sparse matrix is provided
            to a sparse ``csr_array``.

        Returns
        -------
        y : ndarray of shape (n_samples,)
            The predicted values.
        """"""
        raw_predictions = self.decision_function(X)
        if raw_predictions.ndim == 1:  # decision_function already squeezed it
            encoded_classes = (raw_predictions >= 0).astype(int)
        else:
            encoded_classes = np.argmax(raw_predictions, axis=1)
        return self.classes_[encoded_classes]","Predict class for X.

