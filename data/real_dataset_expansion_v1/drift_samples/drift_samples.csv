"semdrift_drift_002575","urllib3","master_head","urllib3/util/ssltransport.py","_ssl_io_loop","def _ssl_io_loop(
        self,
        func: typing.Callable[..., _ReturnValue],
        arg1: None | bytes | int = None,
        arg2: bytearray | None = None,
    ) -> _ReturnValue:
        """"""Performs an I/O loop between incoming/outgoing and the socket.""""""
        should_loop = True
        ret = None

        while should_loop:
            errno = None
            try:
                if arg1 is None and arg2 is None:
                    ret = func()
                elif arg2 is None:
                    ret = func(arg1)
                else:
                    ret = func(arg1, arg2)
            except ssl.SSLError as e:
                if e.errno not in (ssl.SSL_ERROR_WANT_READ, ssl.SSL_ERROR_WANT_WRITE):
                    # WANT_READ, and WANT_WRITE are expected, others are not.
                    raise e
                errno = e.errno

            buf = self.outgoing.read()
            self.socket.sendall(buf)

            if errno is None:
                should_loop = False
            elif errno == ssl.SSL_ERROR_WANT_READ:
                buf = self.socket.recv(SSL_BLOCKSIZE)
                if buf:
                    self.incoming.write(buf)
                else:
                    self.incoming.write_eof()
        return typing.cast(_ReturnValue, ret)","Performs an I/O loop between incoming/outgoing and the socket.

:param encoding: Controls fallback execution behavior.","1","parameter_obsolete","Docstring documents parameter 'encoding' which does not exist in the code signature.","train"
"semdrift_exp_drift_001931","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/physics/quantum/qubit.py","matrix_to_density","def matrix_to_density(mat):
    """"""
    Works by finding the eigenvectors and eigenvalues of the matrix.
