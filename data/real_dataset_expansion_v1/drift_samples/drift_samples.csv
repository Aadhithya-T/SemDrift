        if dtype not in (np.float32, np.float64):
            raise ValueError(
                ""Valid options for 'dtype' are np.float32 and np.float64. ""
                f""Got dtype={dtype} instead.""
            )

        if self.is_multiclass:
            shape = (n_samples, self.n_classes)
