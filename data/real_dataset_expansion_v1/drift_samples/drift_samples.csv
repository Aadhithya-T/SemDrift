    >>> julia_code(e.rhs, assign_to=e.lhs, contract=False)
    'Dy[i] = (y[i + 1] - y[i]) ./ (t[i + 1] - t[i])'
    """"""
    return JuliaCodePrinter(settings).doprint(expr, assign_to)","Converts `expr` to a string of Julia code.

