"semdrift_exp_drift_000655","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/fftpack/_realtransforms.py","dstn","def dstn(x, type=2, shape=None, axes=None, norm=None, overwrite_x=False):
