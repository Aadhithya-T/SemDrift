"semdrift_exp_drift_000429","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/densearith.py","_dup_recurse_pow","def _dup_recurse_pow(f: dup[Er], exp: int, prec: int, K: Domain[Er]) -> dup[Er]:
    """"""
    Helper function for dup_series_pow.
    """"""
    if exp == 1:
        return dup_truncate(f, prec, K)

    q, r = divmod(exp, 2)
    half = _dup_recurse_pow(f, q, prec, K)
    square = dup_series_mul(half, half, prec, K)

    if r == 0:
        return square
    return dup_series_mul(square, f, prec, K)","Executes operation with parameters in order exp, then f.

