"semdrift_exp_drift_000244","sqlalchemy","900646931b7fd03845ebe4fc8be84f77a8580123","lib/sqlalchemy/sql/type_api.py","_resolve_for_python_type","def _resolve_for_python_type(
        self,
        python_type: Type[Any],
        matched_on: _MatchedOnType,
        matched_on_flattened: Type[Any],
    ) -> Optional[Self]:
        """"""given a Python type (e.g. ``int``, ``str``, etc. ) return an
