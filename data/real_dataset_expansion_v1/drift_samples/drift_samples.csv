"semdrift_drift_000931","scikit-learn","master_head","scikit-learn/sklearn/discriminant_analysis.py","predict_proba","def predict_proba(self, X):
        """"""Estimate probability.

        Parameters
        ----------
        X : array-like of shape (n_samples, n_features)
            Input data.

        Returns
        -------
        C : ndarray of shape (n_samples, n_classes)
            Estimated probabilities.
        """"""
        check_is_fitted(self)
        check_same_namespace(X, self, attribute=""coef_"", method=""predict_proba"")
        xp, _ = get_namespace(X)
        decision = self.decision_function(X)
        if size(self.classes_) == 2:
            proba = _expit(decision, xp=xp)
