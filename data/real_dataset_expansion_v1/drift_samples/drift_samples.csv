"semdrift_drift_002347","tornado","master_head","tornado/tornado/httputil.py","_unquote_cookie","def _unquote_cookie(s: str) -> str:
    """"""Handle double quotes and escaping in cookie values.

    This method is copied verbatim from the Python 3.13 standard
    library (http.cookies._unquote) so we don't have to depend on
    non-public interfaces.
    """"""
    # If there aren't any doublequotes,
    # then there can't be any special characters.  See RFC 2109.
    if s is None or len(s) < 2:
        return s
    if s[0] != '""' or s[-1] != '""':
        return s

    # We have to assume that we must decode this string.
    # Down to work.

    # Remove the ""s
    s = s[1:-1]

    # Check for special sequences.  Examples:
    #    \\012 --> \\n
    #    \\""   --> ""
    #
    return _unquote_sub(_unquote_replace, s)","Handle double quotes and escaping in cookie values.

