"semdrift_drift_002415","scikit-learn","master_head","sklearn/datasets/_kddcup99.py","_fetch_brute_kddcup99","def _fetch_brute_kddcup99(
    data_home=None, download_if_missing=True, percent10=True, n_retries=3, delay=1.0
):
    """"""Load the kddcup99 dataset, downloading it if necessary.

