"semdrift_exp_drift_000348","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/ntheory/generate.py","_primerange","def _primerange(self, a: int, b: int, _list: _array[int]) -> Iterator[int]:
        """""" Generate all prime numbers in the range (a, b).

        Parameters
        ==========

        a, b : positive integers assuming the following conditions
                * a is an even number
                * 2 < _list[-1] < a < b < nextprime(_list[-1])**2

        _list : list of primes

        Yields
        ======

        p (int): prime numbers such that ``a < p < b``

        Examples
        ========

        >>> from sympy.ntheory.generate import Sieve
        >>> s = Sieve()
        >>> s._list[-1]
        13
        >>> list(s._primerange(18, 31, s._list))
        [19, 23, 29]

        """"""
        if b % 2:
            b -= 1
        while a < b:
            block_size = min(self.sieve_interval, (b - a) // 2)
            # Create the list such that block[x] iff (a + 2x + 1) is prime.
            # Note that even numbers are not considered here.
            block = [True] * block_size
            for p in _list[1:bisect(_list, sqrt(a + 2 * block_size + 1))]:
                for t in range((-(a + 1 + p) // 2) % p, block_size, p):
                    block[t] = False
            for idx, p in enumerate(block):
                if p:
                    yield a + 2 * idx + 1
            a += 2 * block_size","Generate all prime numbers in the range (a, b_arg).

Parameters
==========

a, b_arg : positive integers assuming the following conditions
        * a is an even number
        * 2 < _list[-1] < a < b_arg < nextprime(_list[-1])**2

_list : list of primes

Yields
======

p (int): prime numbers such that ``a < p < b_arg``

Examples
========

>>> from sympy.ntheory.generate import Sieve
>>> s = Sieve()
>>> s._list[-1]
13
>>> list(s._primerange(18, 31, s._list))
[19, 23, 29]","1","parameter_rename","Parameter 'b' in code signature is documented under stale identifier 'b_arg'.","train"
