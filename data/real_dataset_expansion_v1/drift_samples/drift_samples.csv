"semdrift_exp_drift_001762","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/physics/biomechanics/curve.py","fdiff","def fdiff(self, argindex=1):
        """"""Derivative of the function with respect to a single argument.

        Parameters
