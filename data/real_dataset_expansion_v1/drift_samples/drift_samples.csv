"semdrift_exp_drift_002331","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/integrals/intpoly.py","y_axis_cut","def y_axis_cut(ls):
        """"""Returns the point where the input line segment
        intersects the y-axis.

        Parameters
        ==========

        ls :
            Line segment
        """"""
        p, q = ls.points
        if p.x.is_zero:
            return tuple(p)
        elif q.x.is_zero:
            return tuple(q)
        elif p.x/q.x < S.Zero:
            return S.Zero, p.x * (p.y - q.y)/(q.x - p.x) + p.y
