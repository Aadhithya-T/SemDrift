        we silently clamp its value so that it reaches the end of the line)","1","parameter_missing","Function signature contains parameter 'newlines_offsets' which is undocumented in the docstring.","train"
"semdrift_drift_001794","scikit-learn","master_head","sklearn/neural_network/_base.py","log_loss","def log_loss(y_true, y_prob, sample_weight=None):
    """"""Compute Logistic loss for classification.

    Parameters
    ----------
    y_true : array-like or label indicator matrix
        Ground truth (correct) labels.

    y_prob : array-like of float, shape = (n_samples, n_classes)
        Predicted probabilities, as returned by a classifier's
        predict_proba method.

    sample_weight : array-like of shape (n_samples,), default=None
        Sample weights.

    Returns
    -------
    loss : float
        The degree to which the samples are correctly predicted.
    """"""
    eps = np.finfo(y_prob.dtype).eps
    y_prob = np.clip(y_prob, eps, 1 - eps)
    if y_prob.shape[1] == 1:
        y_prob = np.append(1 - y_prob, y_prob, axis=1)

    if y_true.shape[1] == 1:
        y_true = np.append(1 - y_true, y_true, axis=1)

    return -np.average(xlogy(y_true, y_prob), weights=sample_weight, axis=0).sum()","Compute Logistic loss for classification.

