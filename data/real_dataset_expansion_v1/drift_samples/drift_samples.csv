"semdrift_exp_drift_002365","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/stats/_kde.py","integrate_box_1d","def integrate_box_1d(self, low, high):
        """"""
        Computes the integral of a 1D pdf between two bounds.

        Parameters
        ----------
        low : scalar
            Lower bound of integration.
        high : scalar
            Upper bound of integration.

        Returns
        -------
        value : scalar
            The result of the integral.

        Raises
        ------
        ValueError
            If the KDE is over more than one dimension.

        """"""
        if self.d != 1:
            raise ValueError(""integrate_box_1d() only handles 1D pdfs"")

        stdev = ravel(sqrt(self.covariance))[0]

        normalized_low = ravel((low - self.dataset) / stdev)
        normalized_high = ravel((high - self.dataset) / stdev)

        delta = special.ndtr(normalized_high) - special.ndtr(normalized_low)
        value = np.vecdot(self.weights, delta)
        return value","Computes the integral of a 1D pdf between two bounds.

Parameters
