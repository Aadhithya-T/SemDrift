    """"""
    xp = array_namespace(x, y)
    x, y = xp_promote(x, y, force_floating=True, xp=xp)
    dtype = x.dtype
    device = xp_result_device(x)
    if is_marray(xp):
        mask_x, mask_y = np.asarray(x.mask), np.asarray(y.mask)
