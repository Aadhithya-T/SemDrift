"semdrift_exp_drift_000070","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/stats/_distribution_infrastructure.py","draw","def draw(self, sizes=None, rng=None, proportions=None, region='domain'):
        r""""""Draw random values of all parameters for use in testing.

        Parameters
        ----------
        sizes : iterable of shape tuples
            The size of the array to be generated for each parameter in the
