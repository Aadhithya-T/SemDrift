"semdrift_exp_drift_000432","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/euclidtools.py","_dup_rr_trivial_gcd","def _dup_rr_trivial_gcd(f, g, K):
    """"""Handle trivial cases in GCD algorithm over a ring. """"""
    if not (f or g):
        return [], [], []
    elif not f:
        if K.is_nonnegative(dup_LC(g, K)):
            return g, [], [K.one]
        else:
            return dup_neg(g, K), [], [-K.one]
    elif not g:
        if K.is_nonnegative(dup_LC(f, K)):
            return f, [K.one], []
        else:
            return dup_neg(f, K), [-K.one], []

    return None","Handle trivial cases in GCD algorithm over a ring.

