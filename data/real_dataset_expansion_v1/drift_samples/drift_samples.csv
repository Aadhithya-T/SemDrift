        """"""
        Modern fingerprint property designed to be comparable to OpenSSH.

        Currently only does SHA256 (the OpenSSH default).

        .. versionadded:: 3.2
        """"""
        hashy = sha256(bytes(self))
        hash_name = hashy.name.upper()
