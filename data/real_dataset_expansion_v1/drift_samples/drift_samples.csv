"semdrift_exp_drift_001821","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/linalg/_generate_pyx.py","generate_file_c","def generate_file_c(sigs, lib_name, accelerate, ilp64=False):
    """"""Generate content for C header file for Cython to import.""""""
    if lib_name == 'BLAS':
        preamble = [C_PREAMBLE]
    elif lib_name == 'LAPACK':
        preamble = [C_PREAMBLE, LAPACK_DECLS]
    else:
        raise RuntimeError(f'Unrecognized lib_name: {lib_name}.')
    preamble = ['/*\\n', *COMMENT_TEXT, '*/\\n'] + preamble + [CPP_GUARD_BEGIN]
    decls = [generate_decl_c(**sig, accelerate=accelerate, ilp64=ilp64)
             for sig in sigs]
    content = preamble + decls + [CPP_GUARD_END]
    return ''.join(content)","Generate content for C header file for Cython to import.

