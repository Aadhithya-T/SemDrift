>>> import matplotlib.pyplot as plt
>>> fig = plt.figure()
>>> ax1 = fig.add_subplot(1, 1, 1)
>>> ax1.plot(np.sin(thetaarr) * np.sin(phiarr), np.diag(zdata), ""or"")
>>> ax1.plot(np.sin(thetainterp) * np.sin(phiinterp), zinterp, ""-b"")
