"semdrift_exp_drift_000330","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/fglmtools.py","_update","def _update(s, _lambda, P, domain):
    """"""
    Update ``P`` such that for the updated `P'` `P' v = e_{s}`.
    """"""
    k = min(j for j in range(s, len(_lambda)) if _lambda[j] != domain.zero)

    for r in range(len(_lambda)):
        if r != k:
            P[r] = [P[r][j] - (P[k][j] * _lambda[r]) / _lambda[k] for j in range(len(P[r]))]

    P[k] = [P[k][j] / _lambda[k] for j in range(len(P[k]))]
    P[k], P[s] = P[s], P[k]

    return P","Update ``P`` such that for the updated `P'` `P' v = e_{s}`.

