"semdrift_drift_001105","scikit-learn","master_head","sklearn/utils/sparsefuncs.py","inplace_swap_column","def inplace_swap_column(X, m, n):
    """"""
    Swap two columns of a CSC/CSR matrix in-place.

    Parameters
    ----------
    X : sparse matrix of shape (n_samples, n_features)
        Matrix whose two columns are to be swapped. It should be of
        CSR or CSC format.

    m : int
        Index of the column of X to be swapped.

    n : int
        Index of the column of X to be swapped.

    Examples
    --------
    >>> from sklearn.utils import sparsefuncs
    >>> from scipy import sparse
    >>> import numpy as np
    >>> indptr = np.array([0, 2, 3, 3, 3])
    >>> indices = np.array([0, 2, 2])
    >>> data = np.array([8, 2, 5])
    >>> csr = sparse.csr_array((data, indices, indptr))
    >>> csr.todense()
    array([[8, 0, 2],
           [0, 0, 5],
           [0, 0, 0],
           [0, 0, 0]])
    >>> sparsefuncs.inplace_swap_column(csr, 0, 1)
    >>> csr.todense()
    array([[0, 8, 2],
           [0, 0, 5],
           [0, 0, 0],
           [0, 0, 0]])
    """"""
    if m < 0:
        m += X.shape[1]
    if n < 0:
        n += X.shape[1]
