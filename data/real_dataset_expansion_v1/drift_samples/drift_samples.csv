"semdrift_exp_drift_000644","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/stats/_continuous_distns.py","_sf","def _sf(self, x, beta, m):
        """"""
        Survival function of the crystalball distribution.
        """"""

        def rhs(x, beta, m):
            # M is the same as 1/N used elsewhere.
            M = m/beta/(m - 1)*np.exp(-beta**2/2) + _norm_pdf_C*_norm_cdf(beta)
            return _norm_pdf_C*_norm_sf(x)/M

        def lhs(x, beta, m):
            # Default behavior is OK in the left tail of the SF.
            return 1 - self._cdf(x, beta, m)

        return xpx.apply_where(x > -beta, (x, beta, m), rhs, lhs)","Survival function of the crystalball distribution.

