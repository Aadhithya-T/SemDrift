"semdrift_exp_drift_001235","celery","248739d05c7331ee0e857a3079c80e224e100787","celery/events/event.py","get_exchange","def get_exchange(conn, name=EVENT_EXCHANGE_NAME):
    """"""Get exchange used for sending events.

