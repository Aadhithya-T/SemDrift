"semdrift_exp_drift_000461","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/physics/quantum/circuitplot.py","not_point","def not_point(self, gate_idx, wire_idx):
        """"""Draw a NOT gates as the circle with plus in the middle.""""""
        x = self._gate_grid[gate_idx]
        y = self._wire_grid[wire_idx]
        radius = self.not_radius
        c = Circle(
            (x, y),
            radius,
            ec='k',
            fc='w',
            fill=False,
            lw=self.linewidth
        )
        self._axes.add_patch(c)
        l = Line2D(
            (x, x), (y - radius, y + radius),
            color='k',
            lw=self.linewidth
        )
        self._axes.add_line(l)","Draw a NOT gates as the circle with plus in the middle.

