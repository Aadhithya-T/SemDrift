"semdrift_drift_000944","rich","master_head","rich/examples/downloader.py","copy_url","def copy_url(task_id: TaskID, url: str, path: str) -> None:
    """"""Copy data from a url to a local file.""""""
    progress.console.log(f""Requesting {url}"")
