"semdrift_exp_drift_001870","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/polytools.py","_eval_subs","def _eval_subs(f, old, new):
        """"""Internal implementation of :func:`subs`. """"""
        if old in f.gens:
            if new.is_number:
                return f.eval(old, new)
