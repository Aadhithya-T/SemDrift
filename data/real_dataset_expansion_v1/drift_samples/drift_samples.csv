        return ident
    digest = hashlib.md5(
        ident.encode(""utf-8""), usedforsecurity=False
    ).hexdigest()[:8]
    return f""{ident[:_MAX_PARAM_ID_LEN - 12]}...{digest}""","shorten a very long parameter id for console / junit output.

