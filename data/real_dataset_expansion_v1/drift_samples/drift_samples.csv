    """"""
    * Real*Real               -> Real
    * Real*Imaginary          -> !Real
    * Imaginary*Imaginary     -> Real
    """"""
    if expr.is_number:
        return _RealPredicate_number(expr, assumptions)
    result = True
    for arg in expr.args:
        if _ask_recursive(Q.real(arg), assumptions):
            pass
        elif _ask_recursive(Q.imaginary(arg), assumptions):
            result = result ^ True
        else:
            break
    else:
        if result:
            return True
        # if we cannot deduce expr is real,
        # expr is imaginary only if no arg is zero
        return _ask_recursive(Q.zero(expr), assumptions)","Executes operation with parameters in order assumptions, then expr.

