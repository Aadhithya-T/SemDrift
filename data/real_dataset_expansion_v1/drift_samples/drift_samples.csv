"semdrift_exp_drift_000468","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/printing/latex.py","multiline_latex","def multiline_latex(lhs, rhs, terms_per_line=1, environment=""align*"", use_dots=False, **settings):
