    --------
    >>> from sklearn.utils import safe_mask
    >>> from scipy.sparse import csr_array
    >>> data = csr_array([[1], [2], [3], [4], [5]])
    >>> condition = [False, True, True, False, True]
    >>> mask = safe_mask(data, condition)
    >>> data[mask].toarray()
