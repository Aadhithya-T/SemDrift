"semdrift_exp_drift_001442","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/sparse/linalg/_matfuncs.py","_solve_P_Q","def _solve_P_Q(U, V, structure=None):
    """"""
    A helper function for expm_2009.

    Parameters
    ----------
    U : ndarray
