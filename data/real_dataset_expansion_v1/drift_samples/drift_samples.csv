            color = h, s, l
            if as_cmap:
                colors = light_palette(color, 256, input=""husl"")
                _update_lut(cmap, colors)
                _show_cmap(cmap)
            else:
                pal[:] = light_palette(color, n, input=""husl"")
                palplot(pal)

    if as_cmap:
        return cmap
    return pal","Launch an interactive widget to create a light sequential palette.

