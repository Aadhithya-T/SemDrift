    """"""Memoized version of a rule

    Notes
    =====

    This cache can grow infinitely, so it is not recommended to use this
    than ``functools.lru_cache`` unless you need very heavy computation.
    """"""
    cache: dict[_S, _T] = {}

    def memoized_rl(expr: _S) -> _T:
