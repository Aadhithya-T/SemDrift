"semdrift_drift_002024","jinja","master_head","src/jinja2/environment.py","generate_async","async def generate_async(
        self, *args: t.Any, **kwargs: t.Any
    ) -> t.AsyncGenerator[str, object]:
        """"""An async version of :meth:`generate`.  Works very similarly but
        returns an async iterator instead.
        """"""
        if not self.environment.is_async:
            raise RuntimeError(
                ""The environment was not created with async mode enabled.""
            )

        ctx = self.new_context(dict(*args, **kwargs))

        try:
            agen: t.AsyncGenerator[str, None] = self.root_render_func(ctx)  # type: ignore[assignment]

            async with aclosing(agen):
                async for event in agen:
                    yield event
        except Exception:
            yield self.environment.handle_exception()","An async version of :meth:`generate`.  Works very similarly but
returns an async iterator instead.

