        ip = init_bpython_session()
        mainloop = ip.interact
    else:
        print(""Unknown console backend"")
        return

    if auto_symbols and (
        console_backend != ConsoleBackend.IPYTHON or version_tuple(IPython.__version__) < version_tuple('0.11')):
