"semdrift_exp_drift_000450","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/series/ringflint.py","cos","def cos(self, s: QQSeries) -> QQSeries:
        """"""Compute the cosine of a power series.""""""
        if isinstance(s, fmpq_poly):
            if not s:
                return fmpq_poly([1])
