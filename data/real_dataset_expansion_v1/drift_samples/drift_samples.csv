"semdrift_exp_drift_000936","scipy","e6fa3531f47123a5008fe0909d00256c161b66e9","scipy/linalg/_generate_pyx.py","generate_file_pyx","def generate_file_pyx(sigs, lib_name, header_name, accelerate, ilp64=False):
    """"""Generate content for pyx file with BLAS/LAPACK declarations and tests.""""""
    if lib_name == 'BLAS':
        preamble_template = blas_pyx_preamble
        epilog = blas_py_wrappers
    elif lib_name == 'LAPACK':
        preamble_template = lapack_pyx_preamble
