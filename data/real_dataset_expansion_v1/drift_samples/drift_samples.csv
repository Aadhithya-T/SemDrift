"semdrift_exp_drift_001939","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/galoistools.py","gf_strip","def gf_strip(f: dup[MPZ]) -> dup[MPZ]:
    """"""
    Remove leading zeros from ``f``.


    Examples
    ========

    >>> from sympy.polys.galoistools import gf_strip

    >>> gf_strip([0, 0, 0, 3, 0, 1])
