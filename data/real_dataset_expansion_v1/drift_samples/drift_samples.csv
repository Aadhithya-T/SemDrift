"semdrift_exp_drift_002239","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/combinatorics/homomorphisms.py","_check_homomorphism","def _check_homomorphism(domain, codomain, images):
    """"""
    Check that a given mapping of generators to images defines a homomorphism.

    Parameters
    ==========
    domain : PermutationGroup, FpGroup, FreeGroup
    codomain : PermutationGroup, FpGroup, FreeGroup
    images : dict
        The set of keys must be equal to domain.generators.
        The values must be elements of the codomain.

    """"""
    pres = domain if hasattr(domain, 'relators') else domain.presentation()
    rels = pres.relators
    gens = pres.generators
    symbols = [g.ext_rep[0] for g in gens]
    symbols_to_domain_generators = dict(zip(symbols, domain.generators))
    identity = codomain.identity
    dtype = type(identity)

    def _image(r):
        return dtype.prod(
            images[symbols_to_domain_generators[symbol]]**power
            for symbol, power in r.array_form
        )

    for r in rels:
        if isinstance(codomain, FpGroup):
            s = codomain.equals(_image(r), identity)
            if s is None:
                # only try to make the rewriting system
                # confluent when it can't determine the
                # truth of equality otherwise
                success = codomain.make_confluent()
                s = codomain.equals(_image(r), identity)
                if s is None and not success:
                    raise RuntimeError(""Can't determine if the images ""
                        ""define a homomorphism. Try increasing ""
                        ""the maximum number of rewriting rules ""
                        ""(group._rewriting_system.set_max(new_value); ""
                        ""the current value is stored in group._rewriting""
                        ""_system.maxeqns)"")
        else:
            s = _image(r).is_identity
        if not s:
            return False
    return True","Check that a given mapping of generators to images defines a homomorphism.

Parameters
==========
domain : PermutationGroup, FpGroup, FreeGroup
codomain : PermutationGroup, FpGroup, FreeGroup
images : dict
    The set of keys must be equal to domain.generators.
    The values must be elements of the codomain.

Returns:
    None: This operation performs internal state updating and does not return any value.","1","return_type_mismatch","Docstring specifies that the function returns None, whereas the code explicitly returns a computed object.","train"
