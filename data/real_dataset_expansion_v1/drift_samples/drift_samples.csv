"semdrift_exp_drift_000376","sympy","04a7da3aacdf095556c451cd17f3f33bf241a5f2","sympy/polys/monomials.py","term_div","def term_div(a, b, domain):
    """"""Division of two terms in over a ring/field. """"""
    a_lm, a_lc = a
    b_lm, b_lc = b

    monom = monomial_div(a_lm, b_lm)

    if domain.is_Field:
