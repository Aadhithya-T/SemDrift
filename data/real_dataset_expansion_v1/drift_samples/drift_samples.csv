        ty = _not_a_knot(y_fit, ky)
        (Ax, Ay, Q) = _build_design_matrices(
             x_fit, y_fit, Z, tx, ty, kx, ky)
        C0, fp, _ = _solve_2d_fitpack(Ax, Ay, Q, p,
                                     kx, tx, x_fit, ky, ty,
                                     y_fit, Z_fit)
