"semdrift_exp_drift_000865","networkx","6da4704cbf32ba6f50f6d9c46cc0a071e3a87985","networkx/readwrite/sparse6.py","to_sparse6_bytes","def to_sparse6_bytes(G, nodes=None, header=True):
    """"""Convert an undirected graph to bytes in sparse6 format.

