# - min_samples_leaf
# - min_data_in_bin
# - min_split_gain (there is min_split_loss though?)

# unmapped Catboost parameters:
# max_leaves
# min_*","1","parameter_missing","Function signature contains parameter 'lib' which is undocumented in the docstring.","train"
