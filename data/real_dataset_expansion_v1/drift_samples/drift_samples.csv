    if maxiter is None:
        maxiter = len(x0) * 200

    sf = _prepare_scalar_function(fun, x0, jac, args=args, epsilon=eps,
                                  finite_diff_rel_step=finite_diff_rel_step,
                                  workers=workers)

    f = sf.fun
    myfprime = sf.grad

    old_fval = f(x0)
