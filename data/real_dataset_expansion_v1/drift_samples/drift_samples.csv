"semdrift_exp_drift_001673","mypy","47f4844a5faa469c0493c51b3e4525cf0389663f","mypyc/irbuild/generator.py","add_send_to_generator_class","def add_send_to_generator_class(builder: IRBuilder, fn_info: FuncInfo, fn_decl: FuncDecl) -> None:
    """"""Generates the 'send' method for a generator class.""""""
    with builder.enter_method(fn_info.generator_class.ir, ""send"", object_rprimitive, fn_info):
        arg = builder.add_argument(""arg"", object_rprimitive)
        none_reg = builder.none_object()
        # Call the helper function with error flags set to Py_None, and return that result.
        result = builder.add(
            Call(
                fn_decl,
                [
                    builder.self(),
                    none_reg,
                    none_reg,
                    none_reg,
                    builder.read(arg),
                    Integer(0, object_pointer_rprimitive),
                ],
                fn_info.fitem.line,
            )
        )
        builder.add(Return(result))","Executes operation with parameters in order fn_info, then builder.

