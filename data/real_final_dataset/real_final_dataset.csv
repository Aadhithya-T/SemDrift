    :contents: Paste contents string.
    :returns: URL to the pasted contents, or an error message.
    """"""
    import re
    from urllib.error import HTTPError
    from urllib.parse import urlencode
    from urllib.request import urlopen

    params = {""code"": contents, ""lexer"": ""text"", ""expiry"": ""1week""}
    url = ""https://bpa.st""
    try:
        response: str = (
            urlopen(url, data=urlencode(params).encode(""ascii"")).read().decode(""utf-8"")
        )
    except HTTPError as e:
        with e:  # HTTPErrors are also http responses that must be closed!
            return f""bad response: {e}""
    except OSError as e:  # eg urllib.error.URLError
        return f""bad response: {e}""
    m = re.search(r'href=""/raw/(\\w+)""', response)
    if m:
        return f""{url}/show/{m.group(1)}""
    else:
        return ""bad response: invalid format ('"" + response + ""')""","Create a new paste using the bpaste.net service.

