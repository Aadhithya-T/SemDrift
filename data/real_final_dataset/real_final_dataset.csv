"semdrift_drift_000812","rich","master_head","rich/rich/_loop.py","loop_first_last","def loop_first_last(values: Iterable[T]) -> Iterable[Tuple[bool, bool, T]]:
    """"""Iterate and generate a tuple with a flag for first and last value.""""""
    iter_values = iter(values)
    try:
        previous_value = next(iter_values)
    except StopIteration:
        return
    first = True
    for value in iter_values:
        yield first, False, previous_value
        first = False
        previous_value = value
    yield first, True, previous_value","Iterate and generate a tuple with a flag for first and last value.

