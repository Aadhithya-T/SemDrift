        class_name = self.__class__.__name__.lower()

        active_names = [name for name, est in self.estimators if est != ""drop""]

        if self.voting == ""hard"":
            return np.asarray(
                [f""{class_name}_{name}"" for name in active_names], dtype=object
            )

        # voting == ""soft""
