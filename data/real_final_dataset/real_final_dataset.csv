"semdrift_clean_000389","numpy","2fc7677","numpy/lib/_utils_impl.py","_get_indent","def _get_indent(lines):
    """"""
    Determines the leading whitespace that could be removed from all the lines.
    """"""
    indent = sys.maxsize
    for line in lines:
        content = len(line.lstrip())
        if content:
            indent = min(indent, len(line) - content)
    if indent == sys.maxsize:
        indent = 0
    return indent","Determines the leading whitespace that could be removed from all the lines.","0","none","Code implementation and docstring contract are fully synchronized.","train"
