            key_out = self._compute_key(""D"", key_size)
        else:
            iv_out = self._compute_key(""A"", iv_size)
            key_out = self._compute_key(""C"", key_size)

        engine = self._get_engine(
            name=self.local_cipher,
            key=key_out,
            iv=iv_out,
            operation=self._ENCRYPT,
            aead=aead,
