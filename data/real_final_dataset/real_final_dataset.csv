    result = []
    for data, indices, indptr, y, query_values in r:
        shape = (indptr.shape[0] - 1, n_features)
        X = sp.csr_array((data, indices, indptr), shape)
        X.sort_indices()
        result += _align_api_if_sparse(X), y
        if query_id:
            result.append(query_values)

