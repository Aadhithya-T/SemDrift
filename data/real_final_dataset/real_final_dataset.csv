        qs,
        keep_blank_values,
        strict_parsing,
        encoding=""latin1"",
        errors=""strict"",
        max_num_fields=max_num_fields,
    )
    encoded = {}
    for k, v in result.items():
        encoded[k] = [i.encode(""latin1"") for i in v]
