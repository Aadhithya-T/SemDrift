"semdrift_clean_002592","pytest","e4f7f17","_pytest/_io/saferepr.py","repr_dict","def repr_dict(self, x: dict[object, object], level: int) -> str:
        """"""Represent a dict while preserving its insertion order.

        Differs from ``reprlib.Repr.repr_dict`` by iterating directly over ``x``
        rather than using the stdlib's sorting helper.
        """"""
        fillvalue = ""...""
        n = len(x)
        if n == 0:
            return ""{}""
        if level <= 0:
            return ""{"" + fillvalue + ""}""
        newlevel = level - 1
        repr1 = self.repr1
        pieces = []
        for key in islice(x, self.maxdict):
            keyrepr = repr1(key, newlevel)
            valrepr = repr1(x[key], newlevel)
            pieces.append(f""{keyrepr}: {valrepr}"")
        if n > self.maxdict:
            pieces.append(fillvalue)
        return ""{"" + "", "".join(pieces) + ""}""","Represent a dict while preserving its insertion order.

