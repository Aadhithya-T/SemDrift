>>> brier_score_loss(y_tr_opt, np.array(y_prob) > 0.5)
0.0
>>> brier_score_loss(y_tr_opt, y_prob, scale_by_half=False)
0.075
>>> brier_score_loss(
...    [""eggs"", ""ham"", ""spam""],
...    [[0.8, 0.1, 0.1], [0.2, 0.7, 0.1], [0.2, 0.2, 0.6]],
