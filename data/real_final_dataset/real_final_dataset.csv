        padded_labels = labels[: len(choices)] + ("""",) * max(
            0, len(choices) - len(labels)
        )

        return (
            (valuegetter(choice), label)
            for choice, label in zip(choices, padded_labels, strict=True)
        )","Return a generator over the (value, label) pairs, where value
