"semdrift_drift_002503","scikit-learn","master_head","examples/release_highlights/plot_release_highlights_1_5_0.py","levenshtein_distance","def levenshtein_distance(x, y):
    """"""Return the Levenshtein distance between two strings.""""""
    if x == """" or y == """":
        return max(len(x), len(y))
    if x[0] == y[0]:
        return levenshtein_distance(x[1:], y[1:])
    return 1 + min(
        levenshtein_distance(x[1:], y),
        levenshtein_distance(x, y[1:]),
        levenshtein_distance(x[1:], y[1:]),
