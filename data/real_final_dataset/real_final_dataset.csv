                X_is_sparse=X_is_sparse,
                X_data=X_data,
                X_indices=X_indices,
                X_indptr=X_indptr,
                Y=y,
                sample_weight=sample_weight,
                X_mean=X_sparse_scaling,
                max_iter=max_iter,
                tol=tol,
