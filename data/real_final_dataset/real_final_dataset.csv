        if _num_samples(y) == 0:
            raise ValueError(""y has 0 samples: %r"" % y)
    if neg_label >= pos_label:
        raise ValueError(
            ""neg_label={0} must be strictly less than pos_label={1}."".format(
                neg_label, pos_label
            )
        )

