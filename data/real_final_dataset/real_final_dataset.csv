            ``func(Channel, (str, int), (str, int))``.

        :return: the port number (`int`) allocated by the server

        :raises:
            `.SSHException` -- if the server refused the TCP forward request
        """"""
        if not self.active:
            raise SSHException(""SSH session not active"")
        port = int(port)
        response = self.global_request(
            ""tcpip-forward"", (address, port), wait=True
        )
        if response is None:
            raise SSHException(""TCP forwarding request denied"")
        if port == 0:
            port = response.get_int()
        if handler is None:

            def default_handler(channel, src_addr, dest_addr_port):
                # src_addr, src_port = src_addr_port
                # dest_addr, dest_port = dest_addr_port
                self._queue_incoming_channel(channel)

            handler = default_handler
        self._tcp_handler = handler
        return port","Ask the server to forward TCP connections from a listening port on
