"semdrift_clean_001406","jinja","5ef7011","jinja/scripts/generate_identifier_pattern.py","build_pattern","def build_pattern(ranges):
    """"""Output the regex pattern for ranges of characters.

    One and two character ranges output the individual characters.
    """"""
    out = []

    for a, b in ranges:
        if a == b:  # single char
            out.append(a)
        elif ord(b) - ord(a) == 1:  # two chars, range is redundant
            out.append(a)
            out.append(b)
        else:
            out.append(f""{a}-{b}"")

    return """".join(out)","Output the regex pattern for ranges of characters.

