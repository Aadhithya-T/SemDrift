"semdrift_clean_002571","scikit-learn","2fc7677","sklearn/metrics/_scorer.py","_threshold_scores_to_class_labels","def _threshold_scores_to_class_labels(y_score, threshold, classes, pos_label):
    """"""Threshold `y_score` and return the associated class labels.""""""
    if pos_label is None:
        map_thresholded_score_to_label = np.array([0, 1])
    else:
        pos_label_idx = np.flatnonzero(classes == pos_label)[0]
        neg_label_idx = np.flatnonzero(classes != pos_label)[0]
        map_thresholded_score_to_label = np.array([neg_label_idx, pos_label_idx])

    return classes[map_thresholded_score_to_label[(y_score >= threshold).astype(int)]]","Threshold `y_score` and return the associated class labels.","0","none","Code implementation and docstring contract are fully synchronized.","train"
