"semdrift_clean_001168","scikit-learn","2fc7677","sklearn/decomposition/_dict_learning.py","_minibatch_step","def _minibatch_step(self, X, dictionary, random_state, step):
        """"""Perform the update on the dictionary for one minibatch.""""""
        batch_size = X.shape[0]

