            size = self.getfo(
                remotepath,
                fl,
                callback,
                prefetch,
                max_concurrent_prefetch_requests,
            )
        s = os.stat(localpath)
        if s.st_size != size:
            raise IOError(
                ""size mismatch in get!  {} != {}"".format(s.st_size, size)
            )","Copy a remote file (``remotepath``) from the SFTP server to the local
