"semdrift_drift_000116","scikit-learn","master_head","sklearn/feature_extraction/text.py","_count_vocab","def _count_vocab(self, raw_documents, fixed_vocab):
        """"""Create sparse feature matrix, and vocabulary where fixed_vocab=False""""""
        if fixed_vocab:
            vocabulary = self.vocabulary_
        else:
