"semdrift_clean_001615","scikit-learn","2fc7677","scikit-learn/sklearn/pipeline.py","_name_estimators","def _name_estimators(estimators):
    """"""Generate names for estimators.""""""

    names = [
        estimator if isinstance(estimator, str) else type(estimator).__name__.lower()
        for estimator in estimators
    ]
    namecount = defaultdict(int)
    for est, name in zip(estimators, names):
        namecount[name] += 1

    for k, v in list(namecount.items()):
        if v == 1:
            del namecount[k]

    for i in reversed(range(len(estimators))):
        name = names[i]
        if name in namecount:
            names[i] += ""-%d"" % namecount[name]
            namecount[name] -= 1

    return list(zip(names, estimators))","Generate names for estimators.","0","none","Code implementation and docstring contract are fully synchronized.","train"
