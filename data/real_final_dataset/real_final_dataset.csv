"semdrift_clean_000422","paramiko","142f593","paramiko/paramiko/win_pageant.py","_query_pageant","def _query_pageant(msg):
    """"""
    Communication with the Pageant process is done through a shared
    memory-mapped file.
    """"""
    hwnd = _get_pageant_window_object()
    if not hwnd:
        # Raise a failure to connect exception, pageant isn't running anymore!
        return None

    # create a name for the mmap
    map_name = f""PageantRequest{thread.get_ident():08x}""

    pymap = _winapi.MemoryMap(
        map_name, _AGENT_MAX_MSGLEN, _winapi.get_security_attributes_for_user()
    )
    with pymap:
        pymap.write(msg)
