"semdrift_clean_001656","numpy","2fc7677","numpy/ma/extras.py","polyfit","def polyfit(x, y, deg, rcond=None, full=False, w=None, cov=False):
    """"""
    Any masked values in x is propagated in y, and vice-versa.

    """"""
    x = asarray(x)
    y = asarray(y)

    m = getmask(x)
    if y.ndim == 1:
        m = mask_or(m, getmask(y))
    elif y.ndim == 2:
        my = getmask(mask_rows(y))
        if my is not nomask:
            m = mask_or(m, my[:, 0])
    else:
        raise TypeError(""Expected a 1D or 2D array for y!"")

    if w is not None:
        w = asarray(w)
        if w.ndim != 1:
            raise TypeError(""expected a 1-d array for weights"")
        if w.shape[0] != y.shape[0]:
            raise TypeError(""expected w and y to have the same length"")
        m = mask_or(m, getmask(w))

    if m is not nomask:
        not_m = ~m
        if w is not None:
            w = w[not_m]
        return np.polyfit(x[not_m], y[not_m], deg, rcond, full, w, cov)
    else:
        return np.polyfit(x, y, deg, rcond, full, w, cov)","Any masked values in x is propagated in y, and vice-versa.","0","none","Code implementation and docstring contract are fully synchronized.","train"
"semdrift_drift_000439","paramiko","master_head","paramiko/paramiko/channel.py","send","def send(self, s):
        """"""
        Send data to the channel.  Returns the number of bytes sent, or 0 if
        the channel stream is closed.  Applications are responsible for
        checking that all data has been sent: if only some of the data was
        transmitted, the application needs to attempt delivery of the remaining
        data.

