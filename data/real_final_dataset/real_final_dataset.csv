            DEBUG,
            ""open({!r}, {!r}) -> {}"".format(
                filename, mode, u(hexlify(handle))
            ),
        )
        return SFTPFile(self, handle, mode, bufsize)","Open a file on the remote server.  The arguments are the same as for
