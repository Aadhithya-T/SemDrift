        first_pass = not hasattr(self, ""components_"")

        if check_input:
            if sparse.issparse(X):
                raise TypeError(
                    ""IncrementalPCA.partial_fit does not support ""
                    ""sparse input. Either convert data to dense ""
                    ""or use IncrementalPCA.fit to do so in batches.""
                )
