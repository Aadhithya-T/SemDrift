        with config_context(array_api_dispatch=True):
            result_ns = get_namespace(result_xp)[0].__name__
        # `predict` would be string when `y` is string
        expected_ns = X_ns
        if other_ns_and_device == ""string"" and method_name == ""predict"":
            expected_ns = y_ns
