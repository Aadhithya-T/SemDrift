    y = _enforce_estimator_tags_y(estimator_orig, y)

    est = clone(estimator_orig)
    set_random_state(est)

    X_xp = xp.asarray(X, device=device)
    y_xp = xp.asarray(y, device=device)

    with config_context(array_api_dispatch=True):
        est.fit(X_xp, y_xp)

    methods = (
