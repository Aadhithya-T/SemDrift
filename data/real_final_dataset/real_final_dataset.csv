"semdrift_drift_001193","scikit-learn","master_head","examples/decomposition/plot_sparse_coding.py","ricker_function","def ricker_function(resolution, center, width):
    """"""Discrete sub-sampled Ricker (Mexican hat) wavelet""""""
    x = np.linspace(0, resolution - 1, resolution)
    x = (
        (2 / (np.sqrt(3 * width) * np.pi**0.25))
        * (1 - (x - center) ** 2 / width**2)
        * np.exp(-((x - center) ** 2) / (2 * width**2))
    )
    return x","Discrete sub-sampled Ricker (Mexican hat) wavelet

