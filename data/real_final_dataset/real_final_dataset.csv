"semdrift_clean_002586","tqdm","9cf5a12","tqdm/examples/coroutine_pipe.py","tqdm_pipe","def tqdm_pipe(target, **tqdm_kwargs):
    """"""
    Coroutine chain pipe `send()`ing to `target`.

    This:
    >>> r = receiver()
    >>> p = producer(r)
    >>> next(r)
    >>> next(p)

    Becomes:
    >>> r = receiver()
    >>> t = tqdm.pipe(r)
    >>> p = producer(t)
    >>> next(r)
    >>> next(p)
    """"""
    with tqdm(**tqdm_kwargs) as pbar:
        while True:
            obj = (yield)
            target.send(obj)
            pbar.update()","Coroutine chain pipe `send()`ing to `target`.

