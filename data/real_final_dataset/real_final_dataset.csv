"semdrift_drift_001972","scikit-learn","master_head","examples/model_selection/plot_grid_search_refit_callable.py","best_low_complexity","def best_low_complexity(cv_results):
    """"""
    Balance model complexity with cross-validated score.

    Parameters
    ----------
    cv_results : dict of numpy(masked) ndarrays
        See attribute cv_results_ of `GridSearchCV`.

    Return
    ------
    int
        Index of a model that has the fewest PCA components
        while has its test score within 1 standard deviation of the best
        `mean_test_score`.
    """"""
    threshold = lower_bound(cv_results)
    candidate_idx = np.flatnonzero(cv_results[""mean_test_score""] >= threshold)
    best_idx = candidate_idx[
        cv_results[""param_reduce_dim__n_components""][candidate_idx].argmin()
    ]
    return best_idx","Balance model complexity with cross-validated score.

