"semdrift_clean_000843","pandas","2fc7677","core/arrays/categorical.py","_format_values_line","def _format_values_line(fmt_values: list[str], max_width: int) -> str:
        """"""Format a list of values into a bracketed, width-respecting string.""""""
        if max_width == 0:
            return ""["" + "", "".join(fmt_values) + ""]""

        parts = [""[""]
        cur_col_len = 1  # account for the opening bracket
        start = True
        for val in fmt_values:
            if not start:
                if cur_col_len + 2 + len(val) > max_width:
                    parts.append("",\\n "")
                    cur_col_len = 1  # 1 space indent
                else:
                    parts.append("", "")
                    cur_col_len += 2
            parts.append(val)
            cur_col_len += len(val)
            start = False
        parts.append(""]"")
        return """".join(parts)","Format a list of values into a bracketed, width-respecting string.","0","none","Code implementation and docstring contract are fully synchronized.","train"
