"semdrift_clean_001031","pydantic","68a839f","pydantic/release/push.py","create_github_release_draft","def create_github_release_draft(rl_version: str, rl_release_notes: str):
    """"""Create a GitHub release draft.""""""
    url = f'https://api.github.com/repos/{REPO}/releases'
    headers = {'Authorization': f'token {GITHUB_TOKEN}'}
    data = {
        'tag_name': f'v{rl_version}',
        'name': f'v{rl_version}',
        'body': rl_release_notes,
        'draft': True,
        'prerelease': False,
    }
    response = requests.post(url, json=data, headers=headers, timeout=10)
    try:
        response.raise_for_status()
    except requests.exceptions.HTTPError as e:
        print(f'HTTP error occurred: {e}')
        print(f'Response content: {response.content.decode()}')
        raise e
    release_url = response.json()['html_url']
    # Publishing happens in the edit page
    edit_url = release_url.replace('/releases/tag/', '/releases/edit/')
    return edit_url","Create a GitHub release draft.","0","none","Code implementation and docstring contract are fully synchronized.","train"
