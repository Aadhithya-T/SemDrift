    >>> csr.todense()
    array([[8, 0, 2],
           [0, 0, 5],
           [0, 0, 0],
           [0, 0, 0]])
    >>> sparsefuncs.inplace_swap_column(csr, 0, 1)
    >>> csr.todense()
    array([[0, 8, 2],
           [0, 0, 5],
           [0, 0, 0],
           [0, 0, 0]])
