"semdrift_drift_001894","scikit-learn","master_head","ensemble/_hist_gradient_boosting/gradient_boosting.py","_compute_partial_dependence_recursion","def _compute_partial_dependence_recursion(self, grid, target_features):
        """"""Fast partial dependence computation.

        Parameters
        ----------
