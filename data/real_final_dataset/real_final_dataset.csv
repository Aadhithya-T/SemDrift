"semdrift_drift_001432","scikit-learn","master_head","sklearn/model_selection/_validation.py","_shuffle","def _shuffle(y, groups, random_state):
    """"""Return a shuffled copy of y eventually shuffle among same groups.""""""
    if groups is None:
        indices = random_state.permutation(len(y))
    else:
        indices = np.arange(len(groups))
        for group in np.unique(groups):
            this_mask = groups == group
            indices[this_mask] = random_state.permutation(indices[this_mask])
    return _safe_indexing(y, indices)","Return a shuffled copy of y eventually shuffle among same groups.

