"semdrift_clean_000661","scikit-learn","2fc7677","sklearn/feature_extraction/image.py","_mask_edges_weights","def _mask_edges_weights(mask, edges, weights=None):
    """"""Apply a mask to edges (weighted or not)""""""
    inds = np.arange(mask.size)
    inds = inds[mask.ravel()]
    ind_mask = np.logical_and(np.isin(edges[0], inds), np.isin(edges[1], inds))
    edges = edges[:, ind_mask]
    if weights is not None:
        weights = weights[ind_mask]
    if len(edges.ravel()):
        maxval = edges.max()
    else:
        maxval = 0
    order = np.searchsorted(np.flatnonzero(mask), np.arange(maxval + 1))
    edges = order[edges]
    if weights is None:
        return edges
    else:
        return edges, weights","Apply a mask to edges (weighted or not)","0","none","Code implementation and docstring contract are fully synchronized.","train"
