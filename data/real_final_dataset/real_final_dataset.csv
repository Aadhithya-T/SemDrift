"semdrift_drift_001302","scikit-learn","master_head","scikit-learn/sklearn/discriminant_analysis.py","predict_log_proba","def predict_log_proba(self, X):
        """"""Estimate log class probabilities.

        Parameters
        ----------
        X : {array-like, sparse matrix} of shape (n_samples, n_features)
            Input data.

        Returns
        -------
        y_log_proba : ndarray of shape (n_samples, n_classes)
            Estimated log probabilities.
        """"""
        scores = self._decision_function(X)
        log_likelihood = scores - scores.max(axis=1)[:, np.newaxis]
