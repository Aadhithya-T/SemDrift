"semdrift_drift_002335","scikit-learn","master_head","sklearn/preprocessing/_data.py","inverse_transform","def inverse_transform(self, X):
        """"""Apply the inverse power transformation using the fitted lambdas.

        The inverse of the Box-Cox transformation is given by::

            if lambda_ == 0:
                X_original = exp(X_trans)
            else:
                X_original = (X * lambda_ + 1) ** (1 / lambda_)

        The inverse of the Yeo-Johnson transformation is given by::

            if X >= 0 and lambda_ == 0:
                X_original = exp(X) - 1
            elif X >= 0 and lambda_ != 0:
                X_original = (X * lambda_ + 1) ** (1 / lambda_) - 1
            elif X < 0 and lambda_ != 2:
                X_original = 1 - (-(2 - lambda_) * X + 1) ** (1 / (2 - lambda_))
            elif X < 0 and lambda_ == 2:
                X_original = 1 - exp(-X)

        Parameters
        ----------
        X : array-like of shape (n_samples, n_features)
            The transformed data.

        Returns
        -------
        X_original : ndarray of shape (n_samples, n_features)
            The original data.
        """"""
        check_is_fitted(self)
        X = check_array(
            X,
            copy=self.copy,
            dtype=FLOAT_DTYPES,
            force_writeable=True,
            ensure_all_finite=""allow-nan"",
        )

