    masked_array(data=[1, 4, 5, 7],
                 mask=False,
           fill_value=999999)

    """"""
    if not assume_unique:
        ar1 = unique(ar1)
        ar2 = unique(ar2)

    aux = ma.concatenate((ar1, ar2), axis=None)
    if aux.size == 0:
        return aux
    aux.sort()
    auxf = aux.filled()
