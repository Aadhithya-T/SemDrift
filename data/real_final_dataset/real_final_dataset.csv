    :param include_packages: set to `True` if packages should be returned, too.
    :param recursive: set to `True` if recursion should happen.
    :return: generator
    """"""
    module = import_string(import_path)
    path = getattr(module, ""__path__"", None)
    if path is None:
        raise ValueError(f""{import_path!r} is not a package"")
    basename = f""{module.__name__}.""
    for _importer, modname, ispkg in pkgutil.iter_modules(path):
        modname = basename + modname
        if ispkg:
            if include_packages:
                yield modname
            if recursive:
                yield from find_modules(modname, include_packages, True)
        else:
            yield modname","Finds all the modules below a package.  This can be useful to
